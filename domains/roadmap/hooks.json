{
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        { "type": "command", "command": "python3 \"{{HOOKS_DIR}}/progress_guard.py\"", "timeout": 10 }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "python3 \"{{HOOKS_DIR}}/session_resume.py\"", "timeout": 10 }
      ]
    }
  ]
}
